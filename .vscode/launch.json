{
    "version": "0.0.1",
    "configurations": [
      {
        "name": "Launch app (CMake Debug)",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/app",
        "args": ["--build", "build", "--config", "Debug", "-j", "8"],
        "cwd": "${workspaceFolder}/build",
        "stopOnEntry": false,
        "preLaunchTask": "CMake: build (Debug)"
      }
    ]
  }