{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "CMake: configure (Debug)",
        "type": "shell",
        "command": "cmake",
        "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
        "problemMatcher": []
      },
      {
        "label": "CMake: build (Debug)",
        "type": "shell",
        "command": "cmake",
        "args": ["--build", "build", "-j"],
        "dependsOn": ["CMake: configure (Debug)"],
        "problemMatcher": ["$gcc"]
      }
    ]
  }